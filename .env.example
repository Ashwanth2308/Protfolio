# Copy to .env.local for local builds. Every value is optional; unset = feature off.
# In GitHub Actions, set the same names WITHOUT the VITE_ prefix as repository variables.

# Public URL of the site → canonical/OG URLs, sitemap.xml, rss.xml, CNAME
VITE_SITE_URL=

# Privacy-friendly analytics: plausible | umami | goatcounter
VITE_ANALYTICS=
# Plausible: your domain · Umami: website id · GoatCounter: your code
VITE_ANALYTICS_ID=
# Optional self-hosted script URL (Plausible / Umami)
VITE_ANALYTICS_SRC=

# Contact form: overrides the Formspree endpoint in src/data/portfolio.ts (optional)
VITE_FORM_ENDPOINT=
